FIREWORKS_API_KEY=
# Optional overrides. Leave commented to use the defaults in config.py — an
# empty value would override the default with "". Changing the embed model
# also means changing EMBED_DIM and re-running ingest.py --recreate.
# FIREWORKS_CHAT_MODEL=
# FIREWORKS_EMBED_MODEL=

# JevStation key (jevstation.com) for Jev; only scripts/jev_compare.py uses it. Every
# evaluation spends a credit.
TYPESAFE_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=
POSTGRES_DSN=
REDIS_URL=
# Query-embedding cache (on when REDIS_URL is set). Uncomment to override:
# QUERY_CACHE_ENABLED=false
# QUERY_CACHE_TTL_S=604800

# Ticketing service base URL. Until the ticketing service is deployed, run the stand-in:
#   uv run uvicorn tests.fakes.fake_ticketing:app --port 8081
TICKETING_BASE_URL=http://127.0.0.1:8081

# Shared with the ticketing service: it signs each status webhook with HMAC-SHA256
# of the raw body. Empty rejects every webhook.
WEBHOOK_SECRET=
# Stand-in ticketing only: where it posts its signed status webhooks.
# STAND_IN_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/sr-status
