FIREWORKS_API_KEY=
# Optional overrides. Leave commented to use the defaults in config.py — an
# empty value would override the default with "". Changing the embed model
# also means changing EMBED_DIM and re-running ingest.py --recreate.
# FIREWORKS_CHAT_MODEL=
# FIREWORKS_EMBED_MODEL=

# JevStation key (jevstation.com) for Jev; only scripts/jev_compare.py uses it. Every
# evaluation spends a credit.
TYPESAFE_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=
POSTGRES_DSN=
REDIS_URL=
# Query-embedding cache (on when REDIS_URL is set). Uncomment to override:
# QUERY_CACHE_ENABLED=false
# QUERY_CACHE_TTL_S=604800

# Ticketing service base URL. Until the ticketing service is deployed, run the stand-in:
#   uv run uvicorn tests.fakes.fake_ticketing:app --port 8081
TICKETING_BASE_URL=http://127.0.0.1:8081

# Shared with the ticketing service: it signs each status webhook with HMAC-SHA256
# of the raw body. Empty rejects every webhook.
WEBHOOK_SECRET=
# Stand-in ticketing only: where it posts its signed status webhooks.
# STAND_IN_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/sr-status

# WhatsApp: a private one-to-one chat with the bot (docs/whatsapp.md). Off unless the
# chosen provider's settings and WHATSAPP_ID_SECRET are all set.
WHATSAPP_PROVIDER=meta
# Random, e.g. python -c "import secrets; print(secrets.token_hex(32))". Keys the user id
# derived from each phone number; changing it gives every WhatsApp user a new id.
WHATSAPP_ID_SECRET=

# Meta's WhatsApp Cloud API (free test number): from the app's WhatsApp > API Setup and
# App settings > Basic. META_VERIFY_TOKEN is any random string, entered again in Meta's
# webhook settings.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Twilio instead (WHATSAPP_PROVIDER=twilio; needs a paid account, the free trial can't
# forward inbound messages). The auth token also verifies Twilio's signatures.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The full URL Twilio posts to, exactly as set in the Twilio console.
# WHATSAPP_PUBLIC_URL=

# Local WhatsApp testing: the compose "tunnel" profile (ngrok) gives the api a public address.
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
